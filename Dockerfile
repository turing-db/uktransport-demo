# Single-container image for Railway. Two processes, one exposed port:
#   - TuringDB 3.0 (127.0.0.1:6666) with the uktransport graph loaded
#   - the app's Express server (app/server.js) on $PORT: the built front end,
#     /api -> TuringDB and the assistant's /kit/llm proxy
#
#   stage "web"   - builds the Vite front end in app/ (generated by `kit sync`,
#                   staged by deploy.sh) + its runtime node_modules
#   stage "graph" - builds the uktransport graph from the committed CSV files
#                   with fetch.py --skip-fetch, as run.sh does
#   final stage   - the venv holding the turingdb server, the built graph, the
#                   node binary and the front end
#
# The build context is the directory deploy.sh stages, not the repo checkout.

ARG GRAPH=uktransport

# ---------------------------------------------------------------- stage: web
FROM node:22-bookworm-slim AS web
ARG GRAPH
ENV VITE_DEFAULT_GRAPH=$GRAPH
WORKDIR /web
COPY app/package.json app/package-lock.json ./
# kit sync merges the modules' deps into package.json without refreshing the
# lock file, so `npm ci` would refuse it.
RUN npm install --no-audit --no-fund --loglevel=error
COPY app/ ./
RUN npm run build && npm prune --omit=dev --no-audit --no-fund

# -------------------------------------------------------------- stage: graph
# The turingdb wheel is manylinux_2_35: bookworm's glibc 2.36 runs it.
FROM python:3.12-slim-bookworm AS graph
ARG GRAPH
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY fetch.py ./
COPY data/ data/
RUN /opt/venv/bin/python fetch.py --skip-fetch --data data --turing-dir /turing --graph "$GRAPH"

# -------------------------------------------------------------- stage: final
FROM python:3.12-slim-bookworm
ARG GRAPH
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    GRAPH=$GRAPH \
    TURING_DIR=/turing \
    TURING_API_PORT=6666

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=graph /opt/venv /opt/venv
COPY --from=graph /turing /turing

WORKDIR /app
COPY app/server.js app/kit-llm-proxy.mjs app/package.json ./
COPY --from=web /web/node_modules node_modules
COPY --from=web /web/dist dist
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080
# tini must be PID 1: `turingdb start -demon` runs the server in the
# foreground instead of daemonizing when its parent is PID 1.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/entrypoint.sh"]
